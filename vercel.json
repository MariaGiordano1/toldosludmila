{
  "redirects": [
    {
      "source": "/galeria(.*)",
      "destination": "/#trabajos",
      "permanent": true
    },
    {
      "source": "/(cerramientos|toldos-plegables|toldos-verticales|toldos-punto-recto|toldos-brazo-invisible|toldos|productos)(.*)",
      "destination": "/#productos",
      "permanent": true
